# ------------------------------------------------------------------
# VisaHOBe Agency OS — environment template
# Copy to .env and fill in. Never commit real secrets.
# ------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Database. Leave DATABASE_URL empty to use the bundled SQLite file.
# For PostgreSQL: DATABASE_URL=postgres://visahobe:password@127.0.0.1:5432/visahobe
DATABASE_URL=
DB_FILE=./data/visahobe.db

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_HOURS=336

# Private document storage (never served statically)
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25

# Shared secret between the API server and the self-hosted browser worker
WORKER_TOKEN=
WORKER_URL=ws://127.0.0.1:8787/api/browser/worker
WORKER_LABEL=local-worker
BROWSER_ALLOW_DOMAINS=
BROWSER_BLOCK_DOMAINS=
BROWSER_TIMEOUT_MS=120000
BROWSER_MAX_CONCURRENCY=2

# Local AI (optional). Ollama is auto-detected; no key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------
# Real-time chat (POST /api/chat, Server-Sent Events)
# ------------------------------------------------------------------
# Models are tried in order and the first one that streams wins. Keys stay on
# the server, so operators never paste a key into the browser. The VisaHOBe
# Local Engine always closes the chain, so chat works with none of this set.
AI_CLOUD_NAME=N Space Cloud
# Option A — one OpenAI-compatible relay that holds every key:
AI_CLOUD_URL=
AI_CLOUD_KEY=
# Order of models to try. Empty = the built-in catalogue
# (gpt-4o-mini, gemini-2.5-flash, claude-3-5-haiku, grok-4.3).
AI_CLOUD_MODELS=
# Coarena Model API: one OpenAI-compatible key for GPT-6 Luna, Gemini 3.8 Flash,
# DeepSeek V4.1 and Claude Sonnet 5.5. Get it at https://coarena.ai/account/api/keys
COARENA_API_KEY=
# Optional: restrict which Coarena models appear in the picker
# COARENA_MODELS=gpt-6-luna,gemini-3-8-flash,deepseek-v4-1-flash-1017
# Option B — give this server the vendor keys directly:
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Grok 4.3 is a paid tier: add billing on the xAI account first.
XAI_API_KEY=
# Abort a stream that goes silent for this long (ms).
CHAT_STREAM_TIMEOUT_MS=45000

# Self-hosted Firecrawl (optional)
FIRECRAWL_URL=
FIRECRAWL_API_KEY=

# Google Workspace (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/integrations/google/callback

# Agency policy defaults
PASSPORT_VALIDITY_MONTHS=6

# First-run administrator
BOOTSTRAP_ADMIN_EMAIL=admin@visahobe.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=VisaHOBe Admin

# Comma separated list of allowed browser origins
ALLOWED_ORIGINS=
TRUST_PROXY=false
